<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/nord1"
    app:cardCornerRadius="14dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/nord8"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Row with Logo & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/station_north"
                android:src="@drawable/sn_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="👑 THE QUEEN'S ACADEMY"
                    android:textColor="@color/nord8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masterclass Guide &amp; Curator Tutorial"
                    android:textColor="@color/nord6"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTutorial"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="@color/nord4"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Chapter Selector Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleChapterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/btnChapterCurator"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChapterCurator"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="🎛️ 1. Curator Studio"
                    android:textColor="@color/nord6"
                    android:textSize="10.5sp"
                    app:strokeColor="@color/nord8"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChapterBroadcast"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="📺 2. Broadcast &amp; 2:1"
                    android:textColor="@color/nord6"
                    android:textSize="10.5sp"
                    app:strokeColor="@color/nord7"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChapterLexicon"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="📖 3. SN-Lexikon"
                    android:textColor="@color/nord6"
                    android:textSize="10.5sp"
                    app:strokeColor="@color/nord13"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChapterProTips"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="⚡ 4. Pro Tips &amp; TV"
                    android:textColor="@color/nord6"
                    android:textSize="10.5sp"
                    app:strokeColor="@color/nord14"
                    app:strokeWidth="1dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </HorizontalScrollView>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/nord3" />

        <!-- Chapter Content Scroll Area -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/nord0"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvChapterContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/nord4"
                android:textSize="11.5sp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Footer Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGotIt"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/nord8"
            android:text="👑 UNDERSTOOD, YOUR MAJESTY!"
            android:textColor="@color/nord0"
            android:textSize="11.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
