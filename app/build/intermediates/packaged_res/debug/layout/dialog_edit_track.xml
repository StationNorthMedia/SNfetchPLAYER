<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nord1"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Track &amp; Artist"
        android:textColor="@color/nord6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEditYtId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="YouTube ID: GxBSyx85Kp8"
        android:textColor="@color/nord8"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Track Title"
        android:textColor="@color/nord4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditTitle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@color/nord0"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:paddingHorizontal="10dp"
        android:textColor="@color/nord6"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Artist"
        android:textColor="@color/nord4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditArtist"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@color/nord0"
        android:imeOptions="actionDone"
        android:inputType="textCapWords"
        android:paddingHorizontal="10dp"
        android:textColor="@color/nord6"
        android:textSize="13sp" />

</LinearLayout>
