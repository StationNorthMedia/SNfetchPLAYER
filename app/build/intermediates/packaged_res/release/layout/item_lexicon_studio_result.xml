<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Header Row: Type Badge + Title + YouTube Link Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/nord2"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🎵 SONG"
            android:textColor="@color/nord14"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/nord6"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🔍 YouTube"
            android:textColor="@color/nord13"
            android:textSize="10.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Subtitle Row: Artist & Album details -->
    <TextView
        android:id="@+id/tvResultSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/nord8"
        android:textSize="11.5sp"
        android:textStyle="italic" />

    <!-- Bio Extract Snippet -->
    <TextView
        android:id="@+id/tvResultBio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/nord4"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/nord2" />

</LinearLayout>
