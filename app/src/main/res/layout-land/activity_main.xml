<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nord0"
    android:padding="8dp"
    tools:context=".ui.MainActivity">

    <!-- Top Header Section: Logo + App Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/toggleModeGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgHeaderLogo"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:contentDescription="@string/station_north"
            android:scaleType="fitCenter"
            android:src="@drawable/sn_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/station_north"
                android:textColor="@color/nord6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SNfetchPLAYER • TV Engine"
                android:textColor="@color/nord8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Top Mode Selector Toggle Group -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleModeGroup"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        app:checkedButton="@+id/btnModeTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeTv"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:text="SN-TV"
            android:textColor="@color/nord6"
            android:textSize="11sp"
            app:icon="@drawable/ic_tv"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/nord8"
            app:strokeColor="@color/nord8"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeRadio"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:text="SN-RADIO"
            android:textColor="@color/nord6"
            android:textSize="11sp"
            app:icon="@drawable/ic_radio"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/nord7"
            app:strokeColor="@color/nord7"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeSettings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:text="SETTINGS"
            android:textColor="@color/nord6"
            android:textSize="11sp"
            app:icon="@drawable/ic_edit"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/nord14"
            app:strokeColor="@color/nord14"
            app:strokeWidth="1dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Center Guideline (60% Left / 40% Right) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.60" />

    <!-- ==================== LEFT COLUMN ==================== -->

    <!-- Strict 16:9 Video Player Container (Left Column) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlayerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/cardTrackInfo"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleModeGroup"
        app:strokeColor="@color/nord2"
        app:strokeWidth="1.5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/videoFrameConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="fit"
                app:use_controller="false" />

            <!-- Radio Mode Real Audio Visualizer Overlay -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutRadioOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/nord1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Real FFT Audio Spectrum Visualizer (100% Full Background) -->
                <net.sn.fetchplayer.ui.NordAudioVisualizerView
                    android:id="@+id/audioVisualizer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Standard Non-Fullscreen Radio Header (Logo & Outlined Subtitle) -->
                <LinearLayout
                    android:id="@+id/layoutRadioHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imgRadioLogo"
                        android:layout_width="140dp"
                        android:layout_height="65dp"
                        android:contentDescription="@string/station_north"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sn_logo" />

                    <net.sn.fetchplayer.ui.OutlinedTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:letterSpacing="0.1"
                        android:text="SN-RADIO AUDIO STREAM"
                        android:textColor="@color/nord8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Fullscreen Centered 75% Width Entertainment Display Box -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRadioWikipediaPanel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#D91D212A"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:cardPreventCornerOverlap="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.75"
                    app:strokeColor="@color/nord8"
                    app:strokeWidth="2.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <!-- Beat-Synced Scaling Artist Icon Container -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRadioArtistIconContainer"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_margin="10dp"
                            app:cardBackgroundColor="@color/nord2"
                            app:cardCornerRadius="70dp"
                            app:cardElevation="4dp"
                            app:cardPreventCornerOverlap="false"
                            app:strokeColor="@color/nord7"
                            app:strokeWidth="2.5dp">

                            <ImageView
                                android:id="@+id/imgRadioArtistIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/station_north"
                                android:scaleType="centerCrop"
                                android:src="@drawable/sn_logo" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRadioArtistName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="SN-RADIO // LIVE AUDIO"
                                android:textColor="@color/nord6"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRadioWikipediaSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Station North Digital Radio Stream • Pure R&amp;B &amp; Urban Culture"
                                android:textColor="@color/nord4"
                                android:textSize="15sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 16% TV Watermark Logo -->
            <ImageView
                android:id="@+id/imgTvWatermark"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.45"
                android:contentDescription="@string/station_north"
                android:elevation="10dp"
                android:scaleType="fitEnd"
                android:src="@drawable/sn_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.16"
                app:layout_constraintWidth_percent="0.20" />

            <!-- NOW PLAYING Slanted TV Bauchbinde (Top Right) -->
            <LinearLayout
                android:id="@+id/cardLowerThirds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:elevation="12dp"
                android:gravity="end"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvBauchbindeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:paddingStart="14dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="NOW PLAYING // STATION NORTH"
                    android:textColor="@color/nord0"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutBauchbindeContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvBauchbindeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="Track Title"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/nord6"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="20sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/tvBauchbindeArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="Artist"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/nord8"
                        android:textSize="10.5sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="7.5sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

            </LinearLayout>

            <!-- Touch-Activated Fullscreen On-Screen TV Controls Overlay (HUD) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutTouchHud"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#50000000"
                android:elevation="15dp"
                android:visibility="gone">

                <!-- Floating Bottom Translucent OSD Control Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHudPanel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#DD2E3440"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_max="420dp"
                    app:strokeColor="@color/nord7"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <!-- 1. Exit Fullscreen (Teal) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExitFullscreen"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:clickable="true"
                            android:nextFocusRight="@+id/hudPrevious"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/nord7"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_fullscreen_exit"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/nord0"
                            app:rippleColor="@color/nord6"
                            app:strokeColor="@color/nord7"
                            app:strokeWidth="1.5dp" />

                        <!-- 2. Previous Track (Orange) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hudPrevious"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:clickable="true"
                            android:nextFocusLeft="@+id/btnExitFullscreen"
                            android:nextFocusRight="@+id/hudPlayPause"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/nord12"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_previous"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/nord0"
                            app:rippleColor="@color/nord6"
                            app:strokeColor="@color/nord12"
                            app:strokeWidth="1.5dp" />

                        <!-- 3. Play / Pause (Frost Cyan) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hudPlayPause"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:clickable="true"
                            android:nextFocusLeft="@+id/hudPrevious"
                            android:nextFocusRight="@+id/hudNext"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/nord8"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/nord0"
                            app:rippleColor="@color/nord6"
                            app:strokeColor="@color/nord7"
                            app:strokeWidth="1.5dp" />

                        <!-- 4. Next Track (Purple) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hudNext"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:clickable="true"
                            android:nextFocusLeft="@+id/hudPlayPause"
                            android:nextFocusRight="@+id/hudRepeat"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/nord15"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_next"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/nord0"
                            app:rippleColor="@color/nord6"
                            app:strokeColor="@color/nord15"
                            app:strokeWidth="1.5dp" />

                        <!-- 5. Loop / Repeat (Yellow / Green) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hudRepeat"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:clickable="true"
                            android:nextFocusLeft="@+id/hudNext"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/nord13"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_repeat"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/nord0"
                            app:rippleColor="@color/nord6"
                            app:strokeColor="@color/nord13"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <net.sn.fetchplayer.ui.NordCrateDiggingOverlayView
                android:id="@+id/progressBarBuffering"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="16dp"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Integrated Track Info & Transport Controls Card (Directly Below Strict 16:9 Video Player) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTrackInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/nord1"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/cardPlayerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/nord2"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Top Row: Centered Track Title & Artist -->
            <TextView
                android:id="@+id/tvTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/unknown_title"
                android:textColor="@color/nord6"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTrackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/unknown_artist"
                android:textColor="@color/nord4"
                android:textSize="10sp" />

            <!-- Bottom Row: 5 Equal-Width Responsive Action Tiles (TV D-Pad Focusable) -->
            <LinearLayout
                android:id="@+id/layoutControls"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <!-- Tile 1: Fullscreen (Teal) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullscreenToggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/fabPrevious"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/nord7"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_fullscreen"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/nord0"
                    app:rippleColor="@color/nord6"
                    app:strokeColor="@color/nord7"
                    app:strokeWidth="1.5dp" />

                <!-- Tile 2: Previous (Orange) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabPrevious"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/btnFullscreenToggle"
                    android:nextFocusRight="@+id/fabPlayPause"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/nord12"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_previous"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/nord0"
                    app:rippleColor="@color/nord6"
                    app:strokeColor="@color/nord12"
                    app:strokeWidth="1.5dp" />

                <!-- Tile 3: Play / Pause (Frost Cyan) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabPlayPause"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:clickable="true"
                    android:focusedByDefault="true"
                    android:nextFocusLeft="@+id/fabPrevious"
                    android:nextFocusRight="@+id/fabNext"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/nord8"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/nord0"
                    app:rippleColor="@color/nord6"
                    app:strokeColor="@color/nord7"
                    app:strokeWidth="1.5dp" />

                <!-- Tile 4: Next (Purple) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabNext"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/fabPlayPause"
                    android:nextFocusRight="@+id/fabRepeat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/nord15"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_next"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/nord0"
                    app:rippleColor="@color/nord6"
                    app:strokeColor="@color/nord15"
                    app:strokeWidth="1.5dp" />

                <!-- Tile 5: Loop / Repeat (Yellow / Green) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabRepeat"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/fabNext"
                    android:nextFocusRight="@+id/btnTabArtistInfo"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/nord13"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_repeat"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/nord0"
                    app:rippleColor="@color/nord6"
                    app:strokeColor="@color/nord13"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== RIGHT COLUMN (100% Full Height Artist Info) ==================== -->

    <!-- Artist Info Card (Wikipedia Summary & History List) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArtistInfoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/nord0"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardPlayerContainer"
        app:layout_constraintTop_toBottomOf="@id/toggleModeGroup"
        app:strokeColor="@color/nord8"
        app:strokeWidth="1.5dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp">

            <ProgressBar
                android:id="@+id/progressArtistInfo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/nord8"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvArtistHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Full-Screen Settings Hub Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSettingsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nord0"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleModeGroup"
        app:strokeColor="@color/nord14"
        app:strokeWidth="1.5dp">

        <include
            android:id="@+id/settingsHub"
            layout="@layout/layout_settings_hub" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 1-to-1 Kinetic CSS Splash Screen Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nord0"
        android:elevation="30dp"
        android:visibility="gone">

        <net.sn.fetchplayer.ui.NordKineticSplashView
            android:id="@+id/kineticSplashView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
